{
  "name": "lovable-sched-api",
  "version": "0.0.1",
  "private": true,
  "description": "A per-project cron scheduler built as a Restate Virtual Object in TypeScript",
  "type": "module",
  "scripts": {
    "dev": "tsx watch ./src/app.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmitOnError",
    "start": "node ./dist/app.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check"
  },
  "dependencies": {
    "@restatedev/restate-sdk": "^1.17.0",
    "cron-parser": "^5.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9",
    "typescript-eslint": "^8.70.0"
  }
}
